# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI Realtime Model
# Available models: gpt-realtime-2.1
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Optional: Default voice for the assistant
# Available voices: alloy, ash, ballad, coral, echo, marin, sage, shimmer, verse
OPENAI_REALTIME_VOICE=marin

# GitHub personal access token for repo tools (server-side only)
# Classic: repo (reads plus branch/file/PR writes). Never expose this to the browser.
GITHUB_TOKEN=

# Auth (server-side only — never expose to the browser)
# Dedicated cookie HMAC secret (required in production once VOICE_PASS may be rotated/removed)
VOICE_SESSION_SECRET=

# First-run seed: when the users table is empty, login/signup seeds this email+password (hashed).
VOICE_USER=
VOICE_PASS=
# Optional comma-separated extra usernames/emails for emergency env login only
VOICE_USER_ALIASES=
# Break-glass: allow plaintext VOICE_USER/VOICE_PASS login even after DB users exist (default off)
# VOICE_ALLOW_ENV_LOGIN=false

# Cloudflare D1 + store worker (server-side only) — also stores user accounts
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_STORE_URL=
CLOUDFLARE_STORE_SECRET=
