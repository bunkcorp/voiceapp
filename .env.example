# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenAI Realtime Model
# Available models: gpt-realtime-2.1
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Optional: Default voice for the assistant
# Available voices: alloy, ash, ballad, coral, echo, marin, sage, shimmer, verse
OPENAI_REALTIME_VOICE=marin

# GitHub personal access token for repo tools (server-side only)
# Classic: repo (reads plus branch/file/PR writes). Never expose this to the browser.
GITHUB_TOKEN=

# App login (server-side only — never expose to the browser)
# VOICE_USER is the primary identifier (email). Local-part is also accepted as a username.
VOICE_USER=
VOICE_PASS=
# Optional comma-separated extra usernames/emails
VOICE_USER_ALIASES=
# Optional dedicated cookie HMAC secret. Falls back to VOICE_PASS if unset.
VOICE_SESSION_SECRET=

# Cloudflare D1 + store worker (server-side only)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_STORE_URL=
CLOUDFLARE_STORE_SECRET=
